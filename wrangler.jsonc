{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuiport",
  "main": "build/worker.bundled.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // SSH_HOST_KEY_B64 is NOT required to deploy. Without it the Container uses an
  // ephemeral host key; `bun run setup` stores a stable one. Public SSH arrives
  // through the Worker's `connect()` handler from a Spectrum application whose
  // origin is this Worker — no extra config is needed here.
  "build": { "command": "bun run build" },
  "containers": [
    {
      "name": "tuiport-app",
      "class_name": "TuiportContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TUIPORT", "class_name": "TuiportContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TuiportContainer"] }]
}
